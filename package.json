{
  "name": "nextmoe-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:apps": "pnpm -F \"./apps/**\" --parallel --stream run dev",
    "dev:full": "bash scripts/dev.sh --full",
    "dev:down": "docker compose -f docker-compose.dev.yml --profile full down",
    "dev:doctor": "bash scripts/dev-doctor.sh",
    "dev:db": "bash scripts/create-dev-databases.sh",
    "build": "pnpm -F \"./apps/**\" --parallel run build",
    "format": "pnpm -F \"./apps/**\" --parallel run format",
    "lint": "pnpm -F \"./apps/account\" -F \"./apps/admin\" run lint",
    "lint:fix": "pnpm -F \"./apps/account\" -F \"./apps/admin\" run lint:fix",
    "typecheck": "pnpm -F \"./apps/**\" --parallel run typecheck",
    "sitemap": "esno apps/account/scripts/generateSitemap.ts",
    "old:migrate": "esno scripts/migrate/index.ts",
    "prod:deploy": "./scripts/deploy.sh",
    "pm2:start": "./scripts/start.sh",
    "pm2:stop": "./scripts/stop.sh",
    "pm2:restart": "pm2 restart nextmoe-infra",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "esno": "^4.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.1"
  }
}
