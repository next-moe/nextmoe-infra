{
  "vocabularies": {
    "medium": {
      "label": "媒介",
      "summary": "一条作品记录属于哪一类媒介。它决定作品出现在哪些浏览与筛选里。"
    },
    "content_rating": {
      "label": "内容分级",
      "summary": "作品或 release 的年龄分级。与下面的 sexual / violence 两轴分开记录：分级是结论，两轴是依据。"
    },
    "sexual": {
      "label": "性描写程度",
      "summary": "性相关描写的强度。独立于 content_rating，便于调用方自己定线。"
    },
    "violence": {
      "label": "暴力程度",
      "summary": "暴力描写的强度。独立于 content_rating，便于调用方自己定线。"
    },
    "spoiler": {
      "label": "剧透等级",
      "summary": "一条标注、标签或关联本身的剧透强度，用来决定默认折不折叠。"
    },
    "gender": {
      "label": "性别",
      "summary": "角色或现实人物记录的性别。没有记录时字段是 null，不是某个成员。"
    },
    "blood_type": {
      "label": "血型",
      "summary": "角色的血型。ACGN 设定资料里的常见字段。"
    },
    "release_status": {
      "label": "发售状态",
      "summary": "一个 release 处在发售流程的哪一步。"
    },
    "claim_state": {
      "label": "认领状态",
      "summary": "一条认领（claim）当前的状态，也是它的生命周期机。"
    },
    "content_limit": {
      "label": "内容尺度开关",
      "summary": "调用方声明自己这一次能承接到哪一档内容，服务端据此裁剪返回。"
    },
    "tier": {
      "label": "标签层级",
      "summary": "一个标签在词表里的地位，决定它是否进默认列表。"
    },
    "title_kind": {
      "label": "标题类型",
      "summary": "一条标题是官方名、别名还是简称。"
    },
    "alias_kind": {
      "label": "别名类型",
      "summary": "一条实体别名是译名还是拼写变体。"
    },
    "roster_role": {
      "label": "出演分量",
      "summary": "一个角色在这部作品里的出场分量。"
    },
    "attribution_role": {
      "label": "参与身份",
      "summary": "一家公司以什么身份参与这部作品。同一家公司可以在同一部作品上有多个身份。"
    },
    "company_kind": {
      "label": "公司类型",
      "summary": "一个厂牌 / 公司实体本身是什么类型的组织。"
    },
    "tag_kind": {
      "label": "标签种类",
      "summary": "一个标签描述的是作品内容本身，还是它的元信息。"
    },
    "release_kind": {
      "label": "版本类型",
      "summary": "一个 release 是什么形态的版本。"
    },
    "member_kind": {
      "label": "系列成员类型",
      "summary": "一部作品在它所属系列里的位置。"
    },
    "problem_domain": {
      "label": "错误域",
      "summary": "错误码归属的域，也是 type URI 里的那一段。"
    },
    "sources": {
      "label": "数据源",
      "summary": "一条事实或一个外部 id 取自哪里。开放词表：我们会继续接新的源。"
    },
    "intro_lang": {
      "label": "简介语言",
      "summary": "一条简介所用的语言。闭合词表：仅英、日、简中、繁中。"
    },
    "olang": {
      "label": "原作语言",
      "summary": "作品原作语言，以及标题、别名、角色名等记录所用的语言标签。开放词表。"
    },
    "release_lang": {
      "label": "版本语言",
      "summary": "一个 release 所使用的语言。在原作语言词表之上多了六个仅 release 携带的语言。开放词表。"
    },
    "platform": {
      "label": "运行平台",
      "summary": "一个 release 运行或发售的平台。开放词表。"
    },
    "relation_types": {
      "label": "关联类型",
      "summary": "两个实体之间的关系。标了「对称关系」的，反向也成立。开放词表。"
    }
  },
