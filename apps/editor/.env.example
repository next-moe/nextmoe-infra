# 未萌编辑台 (editor.nextmoe.com) — local dev against the infra dev stack.
# Every value below is already the code default in nuxt.config.ts, so `pnpm dev`
# works without a .env. Nitro also reads these names at runtime, which is how
# docker-compose.prod.yml points the production image at its real hosts.

# Server-only: the OP token endpoint base and the catalog service base the BFF
# calls. Empty NUXT_OAUTH_API_BASE_SSR falls back to the public authorize base.
# NUXT_OAUTH_API_BASE_SSR=http://127.0.0.1:9277/api/v1
# NUXT_CATALOG_API_BASE_SSR=http://127.0.0.1:9281

# Browser-facing OAuth (public client, PKCE, no secret).
# NUXT_PUBLIC_OAUTH_AUTHORIZE_BASE=http://127.0.0.1:9277/api/v1
# NUXT_PUBLIC_OAUTH_WEB_BASE=http://127.0.0.1:9420
# NUXT_PUBLIC_OAUTH_CLIENT_ID=nextmoe-editor
# NUXT_PUBLIC_OAUTH_REDIRECT_URI=http://127.0.0.1:9422/auth/callback
