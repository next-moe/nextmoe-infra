    "@nuxt/eslint": "1.15.2",
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.4.0",
    "nuxt": "^4.5.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.133",
    "@nuxtjs/color-mode": "^4.0.1",
    "eslint": "^10.10.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
