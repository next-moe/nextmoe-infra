{
  "name": "editor",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "icons": "node scripts/generate-icons.mjs",
    "guidelines": "node scripts/build-guidelines.mjs",
    "dev": "nuxt dev",
    "gen:types:catalog-v2": "pnpm dlx openapi-typescript@7.13.0 ../../docs/catalog/v2-openapi.yaml -o shared/types/generated/catalog-v2-api.ts",
