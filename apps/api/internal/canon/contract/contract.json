  "refusal_codes": [
    {
      "code": "CONTRACT_VERSION_UNSUPPORTED",
      "doc": "the row names a contract version fanin does not accept"
    },
    {
      "code": "SNAPSHOT_MISSING",
      "doc": "an evidence snapshot is absent from object storage or its hash differs"
    },
    {
      "code": "EXCERPT_NOT_ON_PAGE",
      "doc": "the cited lines are out of range or not in this lookup's snapshots"
    },
    {
      "code": "VALUE_NOT_ENTAILED",
      "doc": "the excerpt does not support the value for its shape"
    },
    {
      "code": "TIER_NOT_ALLOWED",
      "doc": "the source's grade is not allowed for this property"
    },
    {
      "code": "PROPERTY_OUT_OF_SCOPE",
      "doc": "the program is not registered to write this property"
    },
    {
      "code": "PROPERTY_UNKNOWN",
      "doc": "the property is not in the registry"
    },
    {
      "code": "VOCAB_TERM_UNKNOWN",
      "doc": "the value is not a term of the property's vocabulary"
    },
    {
      "code": "HUMAN_LOCKED",
      "doc": "a person wrote this field; agents do not overwrite it"
    },
    {
      "code": "STRONGER_VALUE_EXISTS",
      "doc": "the current value rests on a stronger tier than this evidence"
    },
    {
      "code": "ENTITY_HELD",
      "doc": "the entity is held (takedown, dispute or review)"
    },
    {
      "code": "ENTITY_MERGED",
      "doc": "the entity was merged; resubmit against its survivor"
    },
    {
      "code": "UNIQUE_CONFLICT",
      "doc": "another entity already holds this unique key"
    },
    {
      "code": "IDENTITY_UNSURE",
      "doc": "identity could not be decided; a todo was opened"
    },
    {
      "code": "REJECTED_IN_REVIEW",
      "doc": "a person reviewed the todo this row opened and rejected it"
    },
    {
      "code": "HOST_EXCLUDED",
      "doc": "the evidence comes from an excluded host"
    }
  ],
