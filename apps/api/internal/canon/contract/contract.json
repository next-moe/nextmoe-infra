  "pool": {
    "inbox": {
      "$ref": "#/$defs/InboxRow"
    },
    "inbox_batch": {
      "$ref": "#/$defs/InboxBatch"
    },
    "outbox": {
      "$ref": "#/$defs/OutboxRow"
    },
    "outbox_page": {
      "$ref": "#/$defs/OutboxPage"
    },
    "record": {
      "$ref": "#/$defs/Record"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot"
    }
  },
  "pool_api": {
    "auth": "Authorization: Bearer \u003cpool token\u003e",
    "inbox": "POST /pool/v0/inbox",
    "outbox": "GET /pool/v0/outbox?after=\u003cid\u003e\u0026limit=\u003cn\u003e",
    "record": "GET /pool/v0/records/{id}",
    "snapshot": "GET /pool/v0/snapshots/{hash}"
  },
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "description": "At least one item, except for a ref property, which is structural.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "property": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "tier": {
          "enum": [
            "official",
            "registry",
            "retailer"
          ],
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "target",
        "property",
        "value",
        "tier",
        "evidence"
      ],
      "type": "object"
    },
    "Changeset": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/NewEntity"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "lead_id": {
          "type": "string"
        }
      },
      "required": [
        "lead_id",
        "entities"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "line_from": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "line_to": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "description": "Field path inside the record.",
          "type": "string"
        },
        "record_id": {
          "description": "A registry record, instead of a snapshot.",
          "type": "string"
        },
        "snapshot_id": {
          "description": "Content hash of the snapshot.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "InboxBatch": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/InboxRow"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "InboxRow": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "CONTRACT_VERSION_UNSUPPORTED",
            "SNAPSHOT_MISSING",
            "EXCERPT_NOT_ON_PAGE",
            "VALUE_NOT_ENTAILED",
            "TIER_NOT_ALLOWED",
            "PROPERTY_OUT_OF_SCOPE",
            "PROPERTY_UNKNOWN",
            "VOCAB_TERM_UNKNOWN",
            "HUMAN_LOCKED",
            "STRONGER_VALUE_EXISTS",
            "ENTITY_HELD",
            "ENTITY_MERGED",
            "UNIQUE_CONFLICT",
            "IDENTITY_UNSURE",
            "REJECTED_IN_REVIEW",
            "HOST_EXCLUDED"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "entity_id": {
          "format": "int64",
          "type": "integer"
        },
        "ids": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "type": "object"
        },
        "outbox_id": {
          "format": "int64",
          "type": "integer"
        },
        "result": {
          "enum": [
            "written",
            "todo",
            "refused"
          ],
          "type": "string"
        }
      },
      "required": [
        "outbox_id",
        "result"
      ],
      "type": "object"
    },
    "LeadResult": {
      "additionalProperties": false,
      "properties": {
        "lead_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "verified",
            "not_eligible",
            "unsure",
            "blocked"
          ],
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "lead_id",
        "outcome"
      ],
      "type": "object"
    },
    "NewEntity": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/Candidate"
          },
          "description": "Keyed by property; each value carries its own evidence.",
          "type": "object"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "entity",
        "properties"
      ],
      "type": "object"
    },
    "OutboxEntry": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "format": "int64",
          "type": "integer"
        },
        "row": {
          "$ref": "#/$defs/OutboxRow"
        }
      },
      "required": [
        "id",
        "created_at",
        "row"
      ],
      "type": "object"
    },
    "OutboxPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/OutboxEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "next_after": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "next_after"
      ],
      "type": "object"
    },
    "OutboxRow": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "changeset": {
          "$ref": "#/$defs/Changeset"
        },
        "contract_version": {
          "enum": [
            "0.1.0"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "candidate",
            "changeset",
            "lead_result"
          ],
          "type": "string"
        },
        "lead_result": {
          "$ref": "#/$defs/LeadResult"
        },
        "lookup_id": {
          "description": "The lookup session that produced the row.",
          "type": "string"
        },
        "program": {
          "description": "Registered program key (plan 05 §9).",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "kind",
        "program"
      ],
      "type": "object"
    },
    "Record": {
      "additionalProperties": false,
      "properties": {
        "fetched_at": {
          "format": "date-time",
          "type": "string"
        },
        "fields": {},
        "hash": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "description": "The source's own key, e.g. an ISBN or a JP-e number.",
          "type": "string"
        },
        "source": {
          "description": "Registered source key, e.g. ndl or jpro.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "key",
        "hash",
        "fetched_at",
        "fields"
      ],
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "cut": {
          "type": "boolean"
        },
        "fetched_at": {
          "format": "date-time",
          "type": "string"
        },
        "final_url": {
          "type": "string"
        },
        "hash": {
          "description": "sha256 of the lines joined by newline, hex.",
          "type": "string"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "requested_url": {
          "type": "string"
        }
      },
      "required": [
        "hash",
        "requested_url",
        "final_url",
        "fetched_at",
        "loaded",
        "cut",
        "lines"
      ],
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "description": "Entity name from this contract.",
          "type": "string"
        },
        "id": {
          "description": "An existing canon id.",
          "format": "int64",
          "type": "integer"
        },
        "ref": {
          "description": "A ref of an entity created in the same changeset.",
          "type": "string"
        }
      },
      "required": [
        "entity"
      ],
      "type": "object"
    }
  }
}
