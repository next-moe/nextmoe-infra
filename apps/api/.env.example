# ─── Server ──────────────────────────────────────────────────────────
KUN_FIBER_SERVER_HOST=127.0.0.1
KUN_FIBER_SERVER_PORT=9277
KUN_ENV=development
# Public URL of the OAuth API itself — used in OAuth metadata, redirects, etc.
KUN_SITE_URL=http://127.0.0.1:9277
# Public URL of the account-center frontend (apps/account). Used to build
# password reset / email change links sent over SMTP. MUST be set in
# production or those emails will point at localhost.
KUN_FRONTEND_URL=http://127.0.0.1:9420

# CORS allow-list for the Nuxt dev servers (apps/account on 9420, apps/admin on 9421).
# Comma-separated. Production: set to the actual origins.
KUN_FRONTEND_CORS_ORIGIN=http://127.0.0.1:9420,http://127.0.0.1:9421

# ─── PostgreSQL — OAuth admin DB (primary) ───────────────────────────
# Holds: users, sessions, oauth_clients, authorization_codes, user_migrations…
KUN_PG_HOST=localhost
KUN_PG_PORT=5432
KUN_PG_USER=postgres
KUN_PG_PASSWORD=your_password_here
KUN_PG_DATABASE=kun_galgame_infra
KUN_PG_SSLMODE=disable
KUN_PG_TIMEZONE=Asia/Shanghai

# ─── PostgreSQL — Galgame Wiki DB ────────────────────────────────────
# The galgame surface (hosted by `cmd/catalog`) and `cmd/migrate-catalog`
# connect here. Host/port/user/password/sslmode/timezone
# all default to the primary KUN_PG_* values above if unset — only the
# DBName is forced different. Override individually if the wiki DB lives
# on a different cluster.
KUN_GALGAME_PG_DATABASE=kun_catalog
# KUN_GALGAME_PG_HOST=          (defaults to KUN_PG_HOST)
# KUN_GALGAME_PG_PORT=          (defaults to KUN_PG_PORT)
# KUN_GALGAME_PG_USER=          (defaults to KUN_PG_USER)
# KUN_GALGAME_PG_PASSWORD=      (defaults to KUN_PG_PASSWORD)
# KUN_GALGAME_PG_SSLMODE=       (defaults to KUN_PG_SSLMODE)
# KUN_GALGAME_PG_TIMEZONE=      (defaults to KUN_PG_TIMEZONE)

# ─── PostgreSQL — image_service DB ───────────────────────────────────
# Same fallback model as the galgame DB above.
KUN_IMAGES_PG_DATABASE=kun_images
# KUN_IMAGES_PG_HOST=
# KUN_IMAGES_PG_PORT=
# KUN_IMAGES_PG_USER=
# KUN_IMAGES_PG_PASSWORD=
# KUN_IMAGES_PG_SSLMODE=
# KUN_IMAGES_PG_TIMEZONE=

# ─── Redis ───────────────────────────────────────────────────────────
# Used for: email verification codes (10min TTL), forgot-password rate
# limit, generic rate limiting. If false, those features degrade
# gracefully (forgot-password errors out, etc.).
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────
# Signing secret for access_token + refresh_token (HS256). MUST be ≥32
# chars in production; rotating it invalidates every issued token.
JWT_SECRET=your_jwt_secret_here_at_least_32_characters
#
# NOTE: access_token TTL is hardcoded 15 minutes; refresh_token TTL is
# per-client via `oauth_clients.refresh_token_ttl_seconds` (default 90
# days, configurable in admin UI). The old JWT_EXPIRES / JWT_COOKIE_NAME
# env vars were dead — removed.

# ─── Auth flow ───────────────────────────────────────────────────────
# Email verification code lifetime (minutes). Applies to register
# (`/auth/register/send-code`) and change-email (`/auth/email/send-code`).
# Same value doubles as the per-email rate-limit window — a second
# code can't be requested until the previous one expires. Floor 1 min;
# default 15.
KUN_AUTH_VERIFICATION_CODE_TTL_MINUTES=15

# ─── SMTP (password reset / email change / register verify) ──────────
# Without these, /auth/password/forgot and /auth/email/* won't send.
# In dev you can leave EMAIL_HOST empty — endpoints will fail soft.
KUN_VISUAL_NOVEL_EMAIL_HOST=
KUN_VISUAL_NOVEL_EMAIL_PORT=587
KUN_VISUAL_NOVEL_EMAIL_ACCOUNT=
KUN_VISUAL_NOVEL_EMAIL_PASSWORD=
KUN_VISUAL_NOVEL_EMAIL_FROM=NextMoe·未萌

# ─── OpenSearch (catalog search) ─────────────────────────────────────
KUN_OPENSEARCH_HOST=http://127.0.0.1:9200
KUN_OPENSEARCH_INDEX_PREFIX=

# ─── image_service ───────────────────────────────────────────────────
# Service this binary itself listens on (when run as `cmd/image`).
KUN_IMAGE_SERVICE_HOST=127.0.0.1
KUN_IMAGE_SERVICE_PORT=9278
# Public CDN base used to construct image URLs from hashes. Must NOT
# have a trailing slash.
KUN_IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/kun-images-dev
KUN_IMAGE_PRESETS_PATH=apps/api/configs/image_presets.yaml

# Upload feature gate. Default false (POST /image/upload returns 503 + code 80015).
# Set to true once calling-side integration is finalized.
# Other endpoints (GET /image/:hash, POST /image/reference-ping, /healthz, /metrics)
# stay enabled regardless.
KUN_IMAGE_UPLOAD_ENABLED=false

# image_service S3 backend (MinIO compat for dev).
KUN_IMAGE_S3_ENDPOINT=http://127.0.0.1:9000
KUN_IMAGE_S3_REGION=us-east-1
KUN_IMAGE_S3_ACCESS_KEY=minioadmin
KUN_IMAGE_S3_SECRET_KEY=minioadmin
KUN_IMAGE_S3_BUCKET=kun-images-dev
KUN_IMAGE_S3_FORCE_PATH_STYLE=true

# image_service caller side (cmd/catalog's galgame surface, cmd/oauth,
# migration scripts
# all call image_service as a Basic-Auth OAuth client). client_id +
# secret must match a registered oauth_client row with image_enabled=true.
# Default BaseURL = http://<KUN_IMAGE_SERVICE_HOST>:<KUN_IMAGE_SERVICE_PORT>
KUN_IMAGE_CLIENT_BASE_URL=
KUN_IMAGE_CLIENT_ID=kungal-test
KUN_IMAGE_CLIENT_SECRET=test-secret-dev

# ─── Developer-platform client fence ─────────────────────────────────
# CSV of OAuth client ids allowed to reach /dev/* with a USER token
# (docs/developer-platform/03 §4.4). Empty = fail-closed: first-party
# /auth/login tokens only. `devportal-dev` is the seeded local portal
# SSO client (docs/developer-platform/05 §9.1 local-dev recipe), so an
# SSO login into the local portal can use /dev/*.
KUN_DEV_PORTAL_CLIENT_IDS=devportal-dev

# ─── store (DLsite distribution face, /v1/store) ─────────────────────
# S2S base URL + the platform's own slk_ key for kungal-link-shortener.
# Either one empty = /v1/store answers 503 and the stats sync job soft-skips.
KUN_STORE_SHORTLINK_BASE_URL=
KUN_STORE_SHORTLINK_API_KEY=
# DLsite affiliate URL templates; {product_id} is the slot. RJ ids use
# maniax, VJ ids use pro. The built-in defaults carry a PLACEHOLDER
# affiliate id (aid/nextmoe) for local development — production supplies
# the real templates through these two variables.
KUN_STORE_DLSITE_AFF_URL_TMPL_MANIAX=
KUN_STORE_DLSITE_AFF_URL_TMPL_PRO=
# How many distinct products one calling application may mint links for.
KUN_STORE_LINK_QUOTA_PER_CLIENT=5000
# Lazy storefront price cache for GET /v2/store/prices. false → both ops 503.
KUN_STORE_PRICE_ENABLED=true
KUN_STORE_PRICE_USER_AGENT=NextMoe-PriceBot/1.0 (+https://www.kungal.com)
KUN_STORE_PRICE_STEAM_REGIONS=jp,cn,us
KUN_STORE_PRICE_DLSITE_CURRENCIES=CNY,USD,TWD,HKD,KRW,EUR
